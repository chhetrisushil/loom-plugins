{
  "name": "loom-plugin-template",
  "version": "0.0.0",
  "private": true,
  "description": "Template for a third-party Loom store plugin — rename me to loom-plugin-<name>.",
  "keywords": [
    "loom",
    "loom-plugin",
    "loom-store"
  ],
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "peerDependencies": {
    "@loom/event-runtime": "*",
    "@loom/plugin-kit": "*",
    "@loom/snapshot-runtime": "*"
  },
  "devDependencies": {
    "@loom/conformance": "*",
    "@loom/event-runtime": "*",
    "@loom/plugin-kit": "*",
    "@loom/snapshot-runtime": "*",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
