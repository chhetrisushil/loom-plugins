{
  "name": "@loomwork/plugin-vector",
  "version": "0.1.6",
  "description": "Vector-similarity MemoryStore for Loom — a third-party implementation of the @loomwork/memory MemoryStore SPI, with a pluggable Embedder and an offline hashing default.",
  "keywords": [
    "loom",
    "loom-plugin",
    "loom-memory",
    "vector",
    "embeddings",
    "retrieval"
  ],
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "peerDependencies": {
    "@loomwork/core": "^0.1.6",
    "@loomwork/memory": "^0.1.6"
  },
  "devDependencies": {
    "@loomwork/core": "*",
    "@loomwork/memory": "*",
    "@loomwork/conformance": "*",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chhetrisushil/loom-plugins.git",
    "directory": "plugins/loom-plugin-vector"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
