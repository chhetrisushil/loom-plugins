{
  "name": "@loomwork/plugin-graph",
  "version": "0.1.7",
  "description": "Knowledge-graph MemoryStore decorator for Loom — graph-expanded retrieval plus a traversal API, over any MemoryStore, with learned edges persisted in the store you already have.",
  "keywords": [
    "loom",
    "loom-plugin",
    "loom-memory",
    "knowledge-graph",
    "graphrag",
    "retrieval"
  ],
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "peerDependencies": {
    "@loomwork/core": "^0.1.7",
    "@loomwork/memory": "^0.1.7"
  },
  "devDependencies": {
    "@loomwork/conformance": "*",
    "@loomwork/core": "*",
    "@loomwork/knowledge": "*",
    "@loomwork/memory": "*",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chhetrisushil/loom-plugins.git",
    "directory": "plugins/loom-plugin-graph"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
